<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.productmanager.controller.ProductController"
      spacing="20" 
      styleClass="main-container"
      stylesheets="@styles.css">
    
    <!-- Titre de l'application -->
    <Label text="Gestion des Produits" styleClass="title-label">
        <font>
            <Font name="Arial" size="24" />
        </font>
    </Label>
    
    <!-- Formulaire d'ajout -->
    <VBox spacing="10" styleClass="form-container">
        <Label text="Ajouter un nouveau produit" styleClass="subtitle-label" />
        
        <HBox spacing="10">
            <VBox spacing="5">
                <Label text="Nom du produit:" />
                <TextField fx:id="nameField" promptText="Entrez le nom" styleClass="text-field" />
            </VBox>
            
            <VBox spacing="5">
                <Label text="Prix (DH):" />
                <TextField fx:id="priceField" promptText="Entrez le prix" styleClass="text-field" />
            </VBox>
        </HBox>
        
        <HBox spacing="10">
            <Button text="Ajouter" onAction="#addProduct" styleClass="btn btn-add" />
            <Button text="Modifier" onAction="#updateProduct" styleClass="btn btn-edit" />
            <Button text="Supprimer" onAction="#deleteProduct" styleClass="btn btn-delete" />
            <Button text="Effacer" onAction="#clearFields" styleClass="btn btn-clear" />
        </HBox>
        
        <Label fx:id="messageLabel" styleClass="message-label" />
    </VBox>
    
    <!-- Liste des produits -->
    <VBox spacing="10" styleClass="list-container">
        <Label text="Liste des produits" styleClass="subtitle-label" />
        
        <ListView fx:id="productListView" styleClass="list-view" />
        
        <!-- Statistiques -->
        <HBox spacing="20" styleClass="stats-container">
            <Label fx:id="totalLabel" styleClass="stats-label" />
            <Label fx:id="averageLabel" styleClass="stats-label" />
            <Label fx:id="countLabel" styleClass="stats-label" />
        </HBox>
    </VBox>
    
</VBox>